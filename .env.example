# Local: copy to .env, replace placeholders and use ./start.sh.
# Vercel: enter real values in Project Settings > Environment Variables.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ENROLLMENT_CODE=replace-with-a-private-room-invite
# Local development uses SQLite when DATABASE_URL is empty.
# Deployment: Neon pooled URL with sslmode=require; use a separate DB/branch for previews.
DATABASE_URL=
# Deployment: set DJANGO_DEBUG=0 and enter your actual hostname(s), comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
